@inherits LayoutComponentBase
@inject IAuthService Auth
@inject IWorkoutStorageService Storage
@inject IPersonalBestService PersonalBests
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @if (_ready)
            {
                @Body
            }
        </article>
    </main>
</div>

@code {
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();

        if (!Auth.IsAuthenticated)
        {
            Navigation.NavigateTo("login");
            return;
        }

        await Storage.SyncWithCloudAsync();
        await PersonalBests.SyncWithCloudAsync();
        _ready = true;
    }
}
