@page "/history"
@inject IWorkoutStorageService Storage
@inject IPersonalBestService PersonalBests
@inject IBodyWeightService BodyWeights
@inject IJSRuntime JS

<PageTitle>Gym Tracker - History</PageTitle>

<h3>History</h3>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <button class="nav-link @(_activeTab == Tab.Workouts ? "active" : "")" @onclick="() => _activeTab = Tab.Workouts">Workouts</button>
    </li>
    <li class="nav-item">
        <button class="nav-link @(_activeTab == Tab.BodyWeight ? "active" : "")" @onclick="() => _activeTab = Tab.BodyWeight">Bodyweight</button>
    </li>
</ul>

@if (_activeTab == Tab.Workouts)
{
    @if (_sessions is null)
    {
        <p>Loading...</p>
    }
    else if (_sessions.Count == 0)
    {
        <p class="text-muted">No workouts logged yet.</p>
    }
    else
    {
        @foreach (var session in _sessions)
        {
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><strong>@session.DayName</strong> - @session.Date.ToString("ddd, d MMM yyyy")</span>
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteSession(session)">Delete</button>
                </div>
                <div class="card-body">
                    @foreach (var exercise in session.Exercises.Where(ex => ex.Sets.Count > 0))
                    {
                        <div class="mb-2">
                            <div class="fw-bold">@exercise.ExerciseName</div>
                            <div class="small">
                                @string.Join(", ", exercise.Sets.Select(s => $"{s.Weight}kg x{s.Reps}{(s.IsWarmup ? " (w)" : "")}"))
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(session.Notes))
                    {
                        <div class="small fst-italic mt-2">"@session.Notes"</div>
                    }
                </div>
            </div>
        }
    }
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Bodyweight</h5>
        <button class="btn btn-outline-primary" @onclick="StartAddWeight">+ Add Entry</button>
    </div>

    @if (_addingWeight)
    {
        <div class="row g-2 mb-3">
            <div class="col-6">
                <input type="date" class="form-control form-control-lg" @bind="_newWeightDate" />
            </div>
            <div class="col-6">
                <input type="number" step="0.1" class="form-control form-control-lg" placeholder="kg" @bind="_newWeightValue" />
            </div>
            <div class="col-12 form-check">
                <input type="checkbox" class="form-check-input" id="new-weight-clothed" @bind="_newIsClothed" />
                <label class="form-check-label" for="new-weight-clothed">Weighed in clothed</label>
            </div>
            <div class="col-12 d-flex gap-2">
                <button class="btn btn-primary flex-fill" @onclick="SaveNewWeight">Save</button>
                <button class="btn btn-outline-secondary flex-fill" @onclick="() => _addingWeight = false">Cancel</button>
            </div>
        </div>
    }

    @if (_bodyWeights is null)
    {
        <p>Loading...</p>
    }
    else if (_bodyWeights.Count == 0)
    {
        <p class="text-muted">No bodyweight entries yet.</p>
    }
    else
    {
        <div class="d-flex flex-wrap gap-3 mb-2">
            <div class="form-check form-check-inline mb-0">
                <input type="checkbox" class="form-check-input" id="chart-show-clothed" @bind="_chartShowClothed" />
                <label class="form-check-label" for="chart-show-clothed">Clothed</label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input type="checkbox" class="form-check-input" id="chart-show-notclothed" @bind="_chartShowNotClothed" />
                <label class="form-check-label" for="chart-show-notclothed">Not clothed</label>
            </div>
            <div class="form-check form-check-inline mb-0">
                <input type="checkbox" class="form-check-input" id="chart-split" @bind="_chartSplitView" />
                <label class="form-check-label" for="chart-split">Split view (separate lines)</label>
            </div>
        </div>

        <BodyWeightChart Entries="_bodyWeights"
                          ShowClothed="_chartShowClothed"
                          ShowNotClothed="_chartShowNotClothed"
                          SplitView="_chartSplitView" />

        <table class="table align-middle mt-3">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Weight (kg)</th>
                    <th>Clothed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _bodyWeights)
                {
                    <tr>
                        <td>@entry.Date.ToString("ddd, d MMM yyyy")</td>
                        <td>
                            @if (_editingDate == entry.Date)
                            {
                                <input type="number" step="0.1" class="form-control form-control-sm" style="width: 100px" @bind="_editWeightValue" />
                            }
                            else
                            {
                                @entry.WeightKg
                            }
                        </td>
                        <td>
                            @if (_editingDate == entry.Date)
                            {
                                <input type="checkbox" class="form-check-input" @bind="_editIsClothed" />
                            }
                            else
                            {
                                @(entry.IsClothed ? "Yes" : "No")
                            }
                        </td>
                        <td class="text-end">
                            @if (_editingDate == entry.Date)
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => SaveEdit(entry.Date)">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEdit(entry)">Edit</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteWeight(entry.Date)">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private enum Tab { Workouts, BodyWeight }

    private Tab _activeTab = Tab.Workouts;
    private List<Models.WorkoutSession>? _sessions;
    private List<Models.BodyWeightEntry>? _bodyWeights;

    private bool _addingWeight;
    private DateOnly _newWeightDate;
    private decimal _newWeightValue;
    private bool _newIsClothed;

    private DateOnly? _editingDate;
    private decimal _editWeightValue;
    private bool _editIsClothed;

    private bool _chartShowClothed = true;
    private bool _chartShowNotClothed = true;
    private bool _chartSplitView;

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
        await LoadBodyWeights();
    }

    private async Task LoadSessions()
    {
        var all = await Storage.GetAllSessionsAsync();
        _sessions = all.OrderByDescending(s => s.Date).ToList();
    }

    private async Task LoadBodyWeights()
    {
        var all = await BodyWeights.GetAllAsync();
        _bodyWeights = all.OrderByDescending(e => e.Date).ToList();
    }

    private async Task DeleteSession(Models.WorkoutSession session)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete {session.DayName} - {session.Date:ddd, d MMM yyyy}? This can't be undone.");
        if (!confirmed)
        {
            return;
        }

        var affectedExercises = session.Exercises.Select(e => e.ExerciseName).Distinct().ToList();

        await Storage.DeleteSessionAsync(session.Id);

        var remaining = await Storage.GetAllSessionsAsync();
        foreach (var exerciseName in affectedExercises)
        {
            await PersonalBests.RecomputeAsync(exerciseName, remaining);
        }

        await LoadSessions();
    }

    private void StartAddWeight()
    {
        _newWeightDate = DateOnly.FromDateTime(DateTime.Now);
        _newWeightValue = 0;
        _newIsClothed = false;
        _addingWeight = true;
    }

    private async Task SaveNewWeight()
    {
        if (_newWeightValue > 0)
        {
            await BodyWeights.SetAsync(_newWeightDate, _newWeightValue, _newIsClothed);
            await LoadBodyWeights();
        }

        _addingWeight = false;
    }

    private void StartEdit(Models.BodyWeightEntry entry)
    {
        _editingDate = entry.Date;
        _editWeightValue = entry.WeightKg;
        _editIsClothed = entry.IsClothed;
    }

    private void CancelEdit()
    {
        _editingDate = null;
    }

    private async Task SaveEdit(DateOnly date)
    {
        await BodyWeights.SetAsync(date, _editWeightValue, _editIsClothed);
        _editingDate = null;
        await LoadBodyWeights();
    }

    private async Task DeleteWeight(DateOnly date)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete the bodyweight entry for {date:ddd, d MMM yyyy}?");
        if (!confirmed)
        {
            return;
        }

        await BodyWeights.DeleteAsync(date);
        await LoadBodyWeights();
    }
}
