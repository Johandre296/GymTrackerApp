@page "/"
@using GymTracker.App.Data
@inject IWorkoutStorageService Storage
@inject IPersonalBestService PersonalBests
@inject IBodyWeightService BodyWeights

<PageTitle>Gym Tracker - Workout</PageTitle>

<PbCelebration Visible="_celebration is not null"
               ExerciseName="@(_celebration?.Name ?? string.Empty)"
               Weight="@(_celebration?.Weight ?? 0)" />

<div class="mb-3">
    <label class="form-label small mb-0">Workout day</label>
    <select class="form-select form-select-lg" value="@_selectedDayName" @onchange="OnDayChanged">
        @foreach (var day in WorkoutProgram.Days)
        {
            <option value="@day.DayName">@day.DayName - @day.FocusLabel</option>
        }
        @foreach (var custom in _customDayNames)
        {
            <option value="@custom">@custom</option>
        }
        <option value="__new__">+ Add new day...</option>
    </select>
    <small class="text-muted">@_today.ToString("dddd, d MMMM yyyy")</small>
</div>

@if (_creatingNewDay)
{
    <div class="input-group mb-3">
        <input class="form-control form-control-lg" placeholder="New day name (e.g. Saturday Arms)"
               @bind="_newDayName" @bind:event="oninput" />
        <button class="btn btn-primary" @onclick="CreateNewDay">Create</button>
        <button class="btn btn-outline-secondary" @onclick="CancelNewDay">Cancel</button>
    </div>
}

@if (_session is not null)
{
    @foreach (var log in _session.Exercises)
    {
        <ExerciseLogCard Exercise="GetExerciseDefinition(log.ExerciseName)"
                          Log="log"
                          PreviousSets="GetPreviousSets(log.ExerciseName)"
                          OnSetAdded="(set) => HandleSetAdded(log, set)"
                          OnSetRemoved="() => HandleSetRemoved(log)"
                          CanRemove="IsAdHocExercise(log.ExerciseName)"
                          OnExerciseRemoved="() => RemoveExercise(log)" />
    }

    @if (_session.Exercises.Count == 0)
    {
        <p class="text-muted">No exercises yet - add one below.</p>
    }

    @if (_addingExercise)
    {
        <div class="input-group mb-3">
            <input class="form-control form-control-lg" placeholder="Exercise name"
                   @bind="_newExerciseName" @bind:event="oninput" />
            <button class="btn btn-primary" @onclick="AddExercise">Add</button>
            <button class="btn btn-outline-secondary" @onclick="() => _addingExercise = false">Cancel</button>
        </div>
    }
    else
    {
        <button class="btn btn-outline-primary w-100 mb-3" @onclick="() => _addingExercise = true">+ Add Exercise</button>
    }

    <div class="card mb-3">
        <div class="card-body">
            <label class="form-label small mb-0">Bodyweight (kg)</label>
            <div class="input-group mb-2">
                <input type="number" step="0.1" class="form-control form-control-lg"
                       value="@_bodyWeightKg" @onchange="OnBodyWeightChanged" />
                @if (_bodyWeightKg is not null)
                {
                    <button class="btn btn-outline-danger" @onclick="ClearBodyWeight">Clear</button>
                }
            </div>
            <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="clothed-checkbox"
                       @bind="_isClothed" @bind:after="OnClothedChangedAsync" />
                <label class="form-check-label" for="clothed-checkbox">Weighed in clothed (incl. shoes etc.)</label>
            </div>

            <label class="form-label small mb-0">Notes</label>
            <textarea class="form-control" rows="3" placeholder="How did it feel? Anything to remember for next time?"
                      @onchange="OnNotesChanged">@_session.Notes</textarea>
        </div>
    </div>
}
else
{
    <p>Loading...</p>
}

@code {
    private DateOnly _today;
    private string _selectedDayName = string.Empty;
    private Models.DayProgram? _dayProgram;
    private Models.WorkoutSession? _session;
    private readonly Dictionary<string, List<Models.SetEntry>> _previousSets = new();
    private List<string> _customDayNames = new();

    private bool _creatingNewDay;
    private string _newDayName = string.Empty;

    private bool _addingExercise;
    private string _newExerciseName = string.Empty;

    private (string Name, decimal Weight)? _celebration;

    private decimal? _bodyWeightKg;
    private bool _isClothed;

    protected override async Task OnInitializedAsync()
    {
        _today = DateOnly.FromDateTime(DateTime.Now);
        _dayProgram = WorkoutProgram.GetForToday();
        _selectedDayName = _dayProgram.DayName;

        var todayWeight = await BodyWeights.GetForDateAsync(_today);
        _bodyWeightKg = todayWeight?.WeightKg;
        _isClothed = todayWeight?.IsClothed ?? false;

        var allSessions = await Storage.GetAllSessionsAsync();
        var hardcodedNames = WorkoutProgram.Days.Select(d => d.DayName).ToHashSet();
        _customDayNames = allSessions
            .Select(s => s.DayName)
            .Distinct()
            .Where(n => !hardcodedNames.Contains(n))
            .OrderBy(n => n)
            .ToList();

        await LoadSession();
    }

    private async Task OnDayChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? string.Empty;
        if (value == "__new__")
        {
            _creatingNewDay = true;
            return;
        }

        _creatingNewDay = false;
        _selectedDayName = value;
        _dayProgram = WorkoutProgram.GetByName(value);
        await LoadSession();
    }

    private async Task CreateNewDay()
    {
        var name = _newDayName.Trim();
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        if (!_customDayNames.Contains(name) && WorkoutProgram.GetByName(name) is null)
        {
            _customDayNames.Add(name);
            _customDayNames.Sort();
        }

        _selectedDayName = name;
        _dayProgram = null;
        _creatingNewDay = false;
        _newDayName = string.Empty;
        await LoadSession();
    }

    private void CancelNewDay()
    {
        _creatingNewDay = false;
        _newDayName = string.Empty;
    }

    private async Task LoadSession()
    {
        _session = await Storage.GetOrCreateSessionAsync(_today, _selectedDayName);

        if (_dayProgram is not null)
        {
            EnsureExerciseExists(_dayProgram.MainLift.Name);
            EnsureExerciseExists(_dayProgram.AssistLift.Name);
        }

        _previousSets.Clear();
        foreach (var log in _session.Exercises)
        {
            _previousSets[log.ExerciseName] = await Storage.GetMostRecentSetsAsync(log.ExerciseName, _session.Id);
        }
    }

    private void EnsureExerciseExists(string name)
    {
        if (!_session!.Exercises.Any(e => e.ExerciseName == name))
        {
            _session.Exercises.Add(new Models.ExerciseLog { ExerciseName = name });
        }
    }

    private Models.ExerciseDefinition GetExerciseDefinition(string name)
    {
        if (_dayProgram is not null)
        {
            if (_dayProgram.MainLift.Name == name)
            {
                return _dayProgram.MainLift;
            }

            if (_dayProgram.AssistLift.Name == name)
            {
                return _dayProgram.AssistLift;
            }
        }

        return new Models.ExerciseDefinition { Name = name };
    }

    private List<Models.SetEntry> GetPreviousSets(string name) =>
        _previousSets.TryGetValue(name, out var sets) ? sets : new();

    private async Task AddExercise()
    {
        var name = _newExerciseName.Trim();
        if (!string.IsNullOrWhiteSpace(name) &&
            !_session!.Exercises.Any(e => string.Equals(e.ExerciseName, name, StringComparison.OrdinalIgnoreCase)))
        {
            _session.Exercises.Add(new Models.ExerciseLog { ExerciseName = name });
            _previousSets[name] = await Storage.GetMostRecentSetsAsync(name, _session.Id);
            await SaveSession();
        }

        _newExerciseName = string.Empty;
        _addingExercise = false;
    }

    private async Task HandleSetAdded(Models.ExerciseLog log, Models.SetEntry set)
    {
        await SaveSession();

        if (!set.IsWarmup)
        {
            var personalBest = await PersonalBests.CheckAndUpdateAsync(log.ExerciseName, set.Weight, set.Reps, _session!.Id);
            if (personalBest is not null)
            {
                TriggerCelebration(log.ExerciseName, personalBest.Weight);
            }
        }
    }

    private async Task HandleSetRemoved(Models.ExerciseLog log)
    {
        await SaveSession();
        var allSessions = await Storage.GetAllSessionsAsync();
        await PersonalBests.RecomputeAsync(log.ExerciseName, allSessions);
    }

    private void TriggerCelebration(string name, decimal weight)
    {
        _celebration = (name, weight);
        _ = AutoHideCelebrationAsync();
    }

    private async Task AutoHideCelebrationAsync()
    {
        await Task.Delay(3500);
        _celebration = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnBodyWeightChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var value))
        {
            _bodyWeightKg = value;
            await BodyWeights.SetAsync(_today, value, _isClothed);
        }
        else
        {
            await ClearBodyWeight();
        }
    }

    private async Task OnClothedChangedAsync()
    {
        if (_bodyWeightKg is not null)
        {
            await BodyWeights.SetAsync(_today, _bodyWeightKg.Value, _isClothed);
        }
    }

    private async Task ClearBodyWeight()
    {
        _bodyWeightKg = null;
        _isClothed = false;
        await BodyWeights.DeleteAsync(_today);
    }

    private bool IsAdHocExercise(string name) =>
        _dayProgram is null || (_dayProgram.MainLift.Name != name && _dayProgram.AssistLift.Name != name);

    private async Task RemoveExercise(Models.ExerciseLog log)
    {
        _session!.Exercises.Remove(log);
        _previousSets.Remove(log.ExerciseName);
        await SaveSession();

        var allSessions = await Storage.GetAllSessionsAsync();
        await PersonalBests.RecomputeAsync(log.ExerciseName, allSessions);
    }

    private async Task OnNotesChanged(ChangeEventArgs e)
    {
        _session!.Notes = e.Value?.ToString() ?? string.Empty;
        await SaveSession();
    }

    private async Task SaveSession()
    {
        if (_session is not null)
        {
            await Storage.SaveSessionAsync(_session);
        }
    }
}
