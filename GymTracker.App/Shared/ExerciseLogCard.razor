@using GymTracker.App.Models
@inject IJSRuntime JS

<div class="card exercise-card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">@Exercise.Name</span>
        <div class="d-flex align-items-center gap-2">
            @if (PreviousSets.Count > 0)
            {
                <small class="text-muted">Last time: @string.Join(", ", PreviousSets.Select(FormatSet))</small>
            }
            @if (CanRemove)
            {
                <button class="btn btn-sm btn-link text-danger p-0" @onclick="RemoveExercise">Remove</button>
            }
        </div>
    </div>
    <div class="card-body">
        @if (Log.Sets.Count > 0)
        {
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Weight (kg)</th>
                        <th>Reps</th>
                        <th>Warmup</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Log.Sets.Count; i++)
                    {
                        var set = Log.Sets[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@set.Weight</td>
                            <td>@set.Reps</td>
                            <td>@(set.IsWarmup ? "Yes" : "")</td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveSet(set)">✕</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <div class="row g-2 add-set-row">
            <div class="col-6">
                <label class="form-label small mb-0">Weight (kg)</label>
                @if (Exercise.AllowsNegativeWeight)
                {
                    <div class="input-group">
                        <button type="button" class="btn btn-outline-secondary" style="width: 3rem" @onclick="ToggleSign">@(_isNegative ? "−" : "+")</button>
                        <input type="number" step="2.5" min="0" class="form-control form-control-lg" @bind="_weightMagnitude" />
                    </div>
                }
                else
                {
                    <input type="number" step="2.5" class="form-control form-control-lg" @bind="_weightMagnitude" />
                }
            </div>
            <div class="col-6">
                <label class="form-label small mb-0">Reps</label>
                <input type="number" step="1" class="form-control form-control-lg" @bind="_reps" />
            </div>
            <div class="col-6 form-check d-flex align-items-center">
                <input type="checkbox" class="form-check-input" id="@($"warmup-{Exercise.Name}")" @bind="_isWarmup" />
                <label class="form-check-label ms-2" for="@($"warmup-{Exercise.Name}")">Warmup</label>
            </div>
            <div class="col-6">
                <button class="btn btn-primary btn-lg w-100" @onclick="AddSet">Add Set</button>
            </div>
        </div>
        @if (Exercise.AllowsNegativeWeight)
        {
            <small class="text-muted d-block mt-1">Machine-assisted: type the assistance amount, the +/− button sets the sign (defaults to −).</small>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ExerciseDefinition Exercise { get; set; } = null!;
    [Parameter, EditorRequired] public ExerciseLog Log { get; set; } = null!;
    [Parameter] public List<SetEntry> PreviousSets { get; set; } = new();
    [Parameter] public EventCallback<SetEntry> OnSetAdded { get; set; }
    [Parameter] public EventCallback OnSetRemoved { get; set; }
    [Parameter] public bool CanRemove { get; set; }
    [Parameter] public EventCallback OnExerciseRemoved { get; set; }

    private decimal _weightMagnitude;
    private int _reps;
    private bool _isWarmup;
    private bool _isNegative;

    protected override void OnInitialized()
    {
        // Assisted exercises (machine-reduced weight) are negative far more often than not, so
        // default the sign there - mobile numeric keypads frequently have no minus key at all,
        // so typing a negative value directly often isn't even possible.
        _isNegative = Exercise.AllowsNegativeWeight;
    }

    private void ToggleSign() => _isNegative = !_isNegative;

    private async Task AddSet()
    {
        var weight = Exercise.AllowsNegativeWeight && _isNegative ? -Math.Abs(_weightMagnitude) : _weightMagnitude;
        var set = new SetEntry
        {
            Weight = weight,
            Reps = _reps,
            IsWarmup = _isWarmup,
        };
        Log.Sets.Add(set);
        _isWarmup = false;
        await OnSetAdded.InvokeAsync(set);
    }

    private async Task RemoveSet(SetEntry set)
    {
        Log.Sets.Remove(set);
        await OnSetRemoved.InvokeAsync();
    }

    private static string FormatSet(SetEntry s) => $"{s.Weight}kg x{s.Reps}{(s.IsWarmup ? " (w)" : "")}";

    private async Task RemoveExercise()
    {
        var message = Log.Sets.Count > 0
            ? $"Remove {Exercise.Name}? This deletes its {Log.Sets.Count} logged set(s) too."
            : $"Remove {Exercise.Name}?";

        var confirmed = await JS.InvokeAsync<bool>("confirm", message);
        if (!confirmed)
        {
            return;
        }

        await OnExerciseRemoved.InvokeAsync();
    }
}
